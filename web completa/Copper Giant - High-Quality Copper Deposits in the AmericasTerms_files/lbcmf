  presetContainer.className = "orb-preset-prompt-container";
  makeInteractive(presetContainer);
  JSON.parse("[\"Latest news?\",\"Upcoming catalysts?\"]").forEach((prompt) => {
    const btn = document.createElement("button");
    btn.className = "orb-preset-prompt-button";
    btn.textContent = prompt;
    btn.addEventListener("click", () => {
