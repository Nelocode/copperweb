  function openModal(url) {
    // Track what was visible before opening modal
    if (chatInputContainer && chatInputContainer.style.display !== "none") {
      previousUIState = "input";
    } else if (chatBtn && chatBtn.style.display !== "none") {
      previousUIState = "button";
    } else if (chatIframe && chatIframe.style.display !== "none") {
      previousUIState = "iframe";
    }
    
    if (chatIframe) chatIframe.style.display = "none";
    if (chatInputContainer) chatInputContainer.style.display = "none";
    if (loadingIndicator) {
      loadingIndicator.style.display = "none";
    }
    shadowContainer.querySelector(".orb-preset-prompt-container")?.style.setProperty("display", "none");

    const existing = modalContent.querySelector("iframe");
    if (existing && existing.parentNode === modalContent) {
      if (existing.dataset.type === "invest" && investResizeHandler) {
        window.removeEventListener("message", investResizeHandler);
        investResizeHandler = null;
      }
      modalContent.removeChild(existing);
    }
       const iframe = document.createElement("iframe");
    iframe.src = url;
    iframe.style.overscrollBehavior = "contain";
    iframe.dataset.type = "invest";
    iframe.style.height = "600px";

    investResizeHandler = (e) => {
      if (e.data?.type === "resizeIframe" && typeof e.data.height === "number") {
        iframe.style.height = e.data.height + "px";
      }
    };
    window.addEventListener("message", investResizeHandler);

    modalContent.appendChild(iframe);
    modal.style.display = "flex";
  }

  function closeModal() {
    modal.style.display = "none";
    const existing = modalContent.querySelector("iframe");
    if (existing && existing.dataset.type === "invest" && investResizeHandler) {
      window.removeEventListener("message", investResizeHandler);
      investResizeHandler = null;
    }
    existing && existing.parentNode === modalContent && modalContent.removeChild(existing);
    
    // Restore the previous UI state
    if (previousUIState) {
      switch (previousUIState) {
        case "input":
          showChatInput();
          // Restore preset prompts if they were visible
          const presetContainer = shadowContainer.querySelector(".orb-preset-prompt-container");
          if (presetContainer && !hasExistingChats) {
            presetContainer.style.display = "flex";
          }
          break;
        case "button":
          showChatButton();
          break;
        case "iframe":
          if (chatIframe) showIframe();
          if (chatBtn) chatBtn.innerHTML = getChatButtonIcon(true);
          break;
      }
      previousUIState = null; // Reset the state
    } else {
      // Fallback to original logic if no previous state was tracked
      if (!chatIframe || chatIframe.style.display === "none") {
        if (hasExistingChats) {
          showChatButton();
        } else {
          showChatInput();
        }
      }
    }
    
