  // Function to adjust invest button position
  function adjustInvestButtonPosition() {
    if (!investBtn) return;
    
    const isMobile = window.innerWidth <= 600;
    if (isMobile) {
      // Mobile: dynamically position based on what's visible
      if (chatIframe && chatIframe.style.display === "block") {
        // Hide invest button when chat is open on mobile (full screen chat)
        investBtn.style.display = "none";
      } else {
        // Show invest button when chat is closed
        investBtn.style.display = "inline-flex";
        
        // Adjust position based on what's visible
        if (chatInputContainer && chatInputContainer.style.display !== "none") {
          // When chat input is visible, keep default left position
          investBtn.style.left = "12px";
          investBtn.style.right = "auto";
        } else if (chatBtn && chatBtn.style.display !== "none") {
          // When only chat button is visible, position closer to it
          // Chat button is at right: 16px with width of 44px (icon only)
          // Position invest button with minimal spacing
          investBtn.style.left = "auto";
          investBtn.style.right = "68px"; // 16px (chat button right) + 44px (button width) + 8px (spacing)
        }
      }
      return;
    }
    
    // Desktop positioning remains the same
    if (chatInputContainer && chatInputContainer.style.display !== "none") {
      // Position next to input container (which is wider)
      investBtn.style.right = "345px";
    } else {
      // Position next to chat button
      investBtn.style.right = "165px";
    }
  }

  // Initialize chat interface based on existing chats
  async function initChatInterface() {
    hasExistingChats = await checkExistingChats();
    
    if (hasExistingChats) {
      // Create Chat Button if user has existing chats
      chatBtn = document.createElement("button");
      chatBtn.className = "orb-chat-button";
      chatBtn.innerHTML = getChatButtonIcon(false);
      makeInteractive(chatBtn);
      chatBtn.addEventListener("click", () => {
        ensureChatIframe();
        const hidden = chatIframe.style.display === "none" || chatIframe.style.display === "";
        if (hidden) {
          // Ensure loading indicator shows immediately, even before iframe starts loading
          if (!iframeLoaded && !loadingIndicator) {
            loadingIndicator = document.createElement("div");
            loadingIndicator.className = "orb-chat-loading";
            loadingIndicator.innerHTML = '<div class="orb-chat-loading-spinner"></div>' +
              '<span class="orb-chat-loading-text">Loading chat...</span>';
            shadowContainer.appendChild(loadingIndicator);
          }
          if (!iframeLoaded && loadingIndicator) {
            loadingIndicator.style.display = "flex";
          }
          showIframe();
        } else {
          chatIframe.style.display = "none";
          if (loadingIndicator) {
            loadingIndicator.style.display = "none";
          }
          storage.setItem('orbiton_chat_dismissed', 'true');
        }
        chatBtn.innerHTML = getChatButtonIcon(hidden);
        
        // Ensure storage flag is set when opening chat via button
        const hasExistingChatsKey = 'hasExistingChats'; // Use separate key for boolean flag
        storage.setItem(hasExistingChatsKey, 'true');
      });
      shadowContainer.appendChild(chatBtn);
    } else {
      // Create input field if user has no existing chats
      chatInputContainer = createChatInput();
      shadowContainer.appendChild(chatInputContainer);
    }
    
    // Preload the chat iframe so it is ready on first interaction
    ensureChatIframe();

    // Adjust invest button position after interface is set up
    setTimeout(adjustInvestButtonPosition, 100);
  }
  
  // Initialize the interface
  initChatInterface();
  
