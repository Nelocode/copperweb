      ensureChatIframe();
      showIframe();
      
      // Call showChatButton after chat is opened
      showChatButton();
      chatBtn.innerHTML = getChatButtonIcon(true);
      
      // Update storage to remember chat was started
      const hasExistingChatsKey = 'hasExistingChats'; // Use separate key for boolean flag
      storage.setItem(hasExistingChatsKey, 'true');
      hasExistingChats = true;

      // handshake
      window.addEventListener("message", function handshake(e) {
        if (e.source === chatIframe.contentWindow && e.data?.type === "chatReady") {
          chatIframe.contentWindow.postMessage(
            { type: "fillInput", question: prompt, newChat: true },
            "*"
          );
          window.removeEventListener("message", handshake);
        }
      });
    });
    presetContainer.appendChild(btn);
  });
  shadowContainer.appendChild(presetContainer);

  global.__orbitonInitialized = true;
  global.__orbitonReady = true;
  while (commandQueue.length) {
    const task = commandQueue.shift();
    try {
      task();
    } catch (error) {
      console.error("Orbiton: error running queued command", error);
    }
  }
  };
  
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", orbitonInit, { once: true });
  } else {
    orbitonInit();
  }
})();
